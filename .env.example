# Server-side runtime variable: where the web server proxies /api/* requests.
# Read at request time, so set this in containers/deployments
# (e.g. API_ORIGIN=http://api:3000 in docker compose).
API_ORIGIN=

# Local dev only. rsbuild statically inlines PUBLIC_* variables at build time,
# so a PUBLIC_API_URL set on a running container has no effect.
PUBLIC_API_URL=http://localhost:3000
